# ==============================================================================
# JARVIS XR — CONFIGURAÇÃO DO AMBIENTE (.env.example)
# Copie este ficheiro para .env e preencha com os seus dados reais.
# NUNCA envie o ficheiro .env para repositórios públicos.
# ==============================================================================

# --- CONFIGURAÇÃO GERAL ---
JARVIS_ENV=production
JARVIS_LOG_LEVEL=INFO
# Token de segurança partilhado entre frontend e backend para autorizar pedidos
JARVIS_API_KEY=change-me-to-a-secure-random-token-min-32-chars

# --- REDE E DOMÍNIO HTTPS (CADDY) ---
# Se usar domínio com DNS-01 Challenge (ex: jarvis.meudominio.com)
# Caso não tenha domínio próprio, configure o IP da VM e use a CA interna do Caddy
JARVIS_DOMAIN=jarvis.homelab.local
CADDY_TLS_MODE=internal
# Exemplo para Cloudflare DNS-01 (opcional):
# CF_API_TOKEN=your_cloudflare_dns_api_token

# --- INTEGRAÇÃO PROXMOX VE ---
PROXMOX_ENABLED=false
PROXMOX_URL=https://192.168.1.100:8006
PROXMOX_TOKEN_ID=jarvis-monitoring@pve!jarvis-token
PROXMOX_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
PROXMOX_VERIFY_SSL=false
PROXMOX_TIMEOUT_SECONDS=10
# VMIDs autorizados a receber ações de ligar/desligar limpo por ACPI/reiniciar (separados por vírgula)
PROXMOX_ALLOWED_VMIDS=101,102

# --- INTEGRAÇÃO HOME ASSISTANT ---
HOME_ASSISTANT_ENABLED=false
HOME_ASSISTANT_URL=http://192.168.1.110:8123
HOME_ASSISTANT_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_token_replace_me
HOME_ASSISTANT_TIMEOUT_SECONDS=5
# Modo de descoberta: "labels" (recomendado) ou "allowlist"
HOME_ASSISTANT_DISCOVERY_MODE=labels
HOME_ASSISTANT_DISCOVERY_LABEL=jarvis
# Entidade opcional para sincronizar o estado de presença em Realidade Aumentada (VR/AR)
HOME_ASSISTANT_PRESENCE_ENTITY=input_boolean.jarvis_xr_active
# IDs de entidades autorizadas separadas por vírgula (usado se DISCOVERY_MODE=allowlist ou como fallback)
HOME_ASSISTANT_ALLOWED_ENTITIES=light.escritorio,switch.tomada_servidor,scene.modo_cinema

# --- INTEGRAÇÃO DNS (PI-HOLE / ADGUARD) ---
# Escolha o fornecedor: "pihole", "adguard", ou "none"
DNS_PROVIDER=none
PIHOLE_URL=http://192.168.1.120:80
PIHOLE_API_TOKEN=
ADGUARD_URL=http://192.168.1.120:3000
ADGUARD_USERNAME=admin
ADGUARD_PASSWORD=replace_with_password

# --- SERVIÇOS DO HOMELAB PARA HEALTHCHECK ---
# Formato JSON com allowlist de serviços a monitorizar por HTTP GET
HOMELAB_SERVICES=[{"name":"Proxmox VE","url":"https://192.168.1.100:8006"},{"name":"Home Assistant","url":"http://192.168.1.110:8123"},{"name":"Pi-hole","url":"http://192.168.1.120"}]

